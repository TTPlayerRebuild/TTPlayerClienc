#include <winver.h>
1 VERSIONINFO
FILEVERSION @CLIENC_FIXED_VERSION@
PRODUCTVERSION @CLIENC_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer CLIENC audio add-in\0"
      VALUE "FileVersion", "@CLIENC_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_clienc\0"
      VALUE "OriginalFilename", "ttp_clienc.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild APE\0"
      VALUE "ProductVersion", "@CLIENC_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
